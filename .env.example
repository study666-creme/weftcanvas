# Docker Compose: copy to .env and replace both secrets before starting.
POSTGRES_PASSWORD=
IDENTITY_SESSION_SECRET=
WEB_PORT=127.0.0.1:8080
API_PORT=127.0.0.1:8787
APP_ORIGINS=http://127.0.0.1:8080
REGISTRATION_CREDIT_MICROS=0
# 可信代理列表（IP/CIDR，逗号或空格分隔；loopback=回环）。只有直连对端在列表里时，
# 登录/注册等限流才读 X-Forwarded-For / CF-Connecting-IP；直连访问一律用真实对端地址。
# Compose 默认地址池在 172.16/12，与 docker-compose.yml 的默认值一致；
# 换了 docker 地址池（192.168/16、10/8）或前面挂了别的反代/Cloudflare 就在这里改。
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# Optional server catalog (BYOK uses the browser settings instead).
CANVAS_UPSTREAM_CATALOG_URL=
CANVAS_UPSTREAM_PRICING_URL=
CANVAS_UPSTREAM_VIDEO_INVENTORY_URL=

# Optional generation worker: endpoint protocol must match the native worker.
CANVAS_UPSTREAM_API_BASE_URL=
CANVAS_UPSTREAM_API_KEY=
GENERATION_MEDIA_HOSTS=
MEDIA_SIGNING_SECRET=
MEDIA_PUBLIC_BASE_URL=

# Optional operator pages. The ops secret falls back to the model secret.
MODEL_OVERRIDES_ADMIN_SECRET=
CANVAS_OPS_ADMIN_SECRET=

# Local development only (pnpm dev:api). Compose supplies its own database URL.
DATABASE_URL=postgresql://canvas:change-me@127.0.0.1:5432/canvas
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=weftcanvas_session
CATALOG_SNAPSHOT_PATH=.data/model-catalog.json
MODEL_OVERRIDES_PATH=.data/model-overrides.json
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_STORAGE_PATH=.data/media-objects
GENERATION_STAGING_PATH=.data/generation-results
GENERATION_DOWNLOAD_PATH=.data/generation-downloads
