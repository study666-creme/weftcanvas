PORT=8787
NODE_ENV=development
DATABASE_URL=postgresql://canvas:change-me@127.0.0.1:5432/weftcanvas
WEFTCANVAS_CATALOG_URL=  # 自托管目录端点（OpenAI-compatible）；托管部署由私有 overlay 提供默认
# 视频准入清单：默认执行器目录（Prompt Hub），它已按「当前有没有可用渠道」
# 做过 fail-closed 过滤。纬线目录只是上架/定价权威——两者实测并不一致，
# 差集里的模型会报价通过、点生成才报「模型不可用」，所以准入以执行器为准。
VIDEO_INVENTORY_URL=  # 可选：视频准入清单端点（托管部署由私有 overlay 提供默认）
CATALOG_SNAPSHOT_PATH=.data/model-catalog.json

# Operator model overrides (hide a model from new generations / set its retail
# price). Leave the secret empty to disable the admin surface entirely; the
# catalog then serves exactly what the upstream publishes.
MODEL_OVERRIDES_PATH=.data/model-overrides.json
MODEL_OVERRIDES_ADMIN_SECRET=

# Comma-separated exact browser origins. Production should normally contain one HTTPS origin.
APP_ORIGINS=http://127.0.0.1:4173
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_NAME=weftcanvas_session
SESSION_TTL_SECONDS=86400
REGISTRATION_CREDIT_MICROS=0
GENERATION_MAX_ACTIVE_JOBS=3
GENERATION_SUBMIT_PER_MINUTE=10
GENERATION_SUBMIT_PER_DAY=100
GENERATION_READ_PER_MINUTE=180
GENERATION_STREAMS_PER_MINUTE=30
GENERATION_STREAMS_PER_USER=3
GENERATION_STREAMS_GLOBAL=200
GENERATION_SSE_POLL_MS=1000
GENERATION_SSE_HEARTBEAT_MS=15000
GENERATION_SSE_MAX_MS=600000
MEDIA_STORAGE_DRIVER=filesystem
MEDIA_STORAGE_PATH=.data/media-objects

# Required only when MEDIA_STORAGE_DRIVER=s3. Keep every value server-only.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_KEY_PREFIX=canvas
S3_KEY_DERIVATION_SECRET=
S3_TEMP_PATH=.data/media-temp
S3_UPLOAD_TTL_SECONDS=900
S3_DOWNLOAD_TTL_SECONDS=300
S3_MAX_MATERIALIZED_BYTES=536870912

MEDIA_SIGNING_SECRET=
MEDIA_PUBLIC_BASE_URL=
WEFTCANVAS_API_BASE_URL=  # worker 生成执行网关（OpenAI-compatible），必填
WEFTCANVAS_API_KEY=
GENERATION_MEDIA_HOSTS=
GENERATION_STAGING_PATH=.data/generation-results
GENERATION_DOWNLOAD_PATH=.data/generation-downloads
# Hosted (Prompt Hub) image tasks outlive this budget converge to a retryable
# timeout instead of an indefinite "generating" state. Video is exempt because
# long renders are normal. 10 minutes by default.
PROMPT_HUB_IMAGE_MAX_LIFETIME_MS=600000
# Same bound for the native (non-hosted) worker path.
GENERATION_IMAGE_MAX_LIFETIME_MS=600000
WORKER_ID=
WORKER_LEASE_MS=60000
WORKER_HEARTBEAT_MS=20000
WORKER_IDLE_DELAY_MS=1000
WORKER_TEMP_RETENTION_MS=86400000

# --- Private Agent runtime (apps/agent, started with `pnpm dev:agent`) ------
# AGENT_RUNTIME_URL and AGENT_RUNTIME_TOKEN must be set together. The API then
# forwards Agent runs, and the browser's local-connector channel, to the runtime.
AGENT_RUNTIME_URL=http://127.0.0.1:8790
AGENT_RUNTIME_TOKEN=
AGENT_RUNTIME_TIMEOUT_MS=300000
AGENT_INCLUDE_TOKEN_MODELS=false

# Agent runtime model access (read by apps/agent, never by the browser).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Local Agent connectors (read by apps/agent) -----------------------------
# Codex 连接：把画布通过 MCP 交给本机 Codex 操作。`codex` 需在 PATH 上，
# 或由 CODEX_BIN 指向可执行文件。
CODEX_BIN=codex
CODEX_CONNECTOR_ENABLED=false
# Blender 连接：点「连接」时运行时会自己找 Blender、装插件并启动它。
BLENDER_BRIDGE_ADDRESS=127.0.0.1:9876
BLENDER_CONNECTOR_ENABLED=false
# 可选覆盖：Blender 可执行文件 / 用户插件目录（找不到或想装到别处时用）。
WEFTCANVAS_BLENDER_BIN=
WEFTCANVAS_BLENDER_ADDONS_DIR=
# 外部连接下发一条画布指令后，等待浏览器执行回执的上限。
CANVAS_CONTROL_WAIT_MS=60000
