{
  "name": "@weftcanvas/canvas-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "package.json"
  ],
  "exports": {
    "./worker": {
      "types": "./src/worker-exports.ts",
      "import": "./dist/worker-exports.js"
    }
  },
  "scripts": {
    "db:migrate": "node dist/database/migrate.js",
    "db:migrate:dev": "tsx src/database/migrate.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && pnpm test:scripts",
    "test:scripts": "node --test scripts/newapi-catalog-export.test.mjs scripts/upstream-conformance.test.mjs",
    "test:postgres": "vitest run --maxWorkers=1 src/generation/api-rate-limit.integration.test.ts src/generation/postgres-store.integration.test.ts src/generation/reconciliation.integration.test.ts src/generation/work-queue.integration.test.ts src/identity/postgres-store.integration.test.ts src/media/postgres-store.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@hono/node-server": "2.0.11",
    "@weftcanvas/contracts": "workspace:*",
    "@smithy/node-http-handler": "^4.9.4",
    "hono": "4.12.30",
    "mediainfo.js": "0.3.7",
    "pg": "8.22.0",
    "sharp": "0.35.3",
    "undici": "^8.12.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
