# Cloudflare Pages header rules for the public Web origin.
# `_worker.js` sets the immutable Cache-Control itself because advanced mode
# ignores this file; the rules below survive if advanced mode is ever dropped.
#
# 公开树（物化覆盖）：这里只允许同源嵌入。私有托管站点另有自己的 CSP 契约
# （允许 Prompt Hub 控制台与子站内嵌），那份允许列表属于私有部署，不进公开树。
#
# Hashed bundles and the auth-film textures never change under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/film/*
  Cache-Control: public, max-age=31536000, immutable

# MediaPipe 运行时与任务模型（人脸检测 / 人像分割），同上：
# 换模型或换运行时版本必须换文件名（见 public/mediapipe/NOTICE.txt）。
/mediapipe/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Content-Security-Policy: base-uri 'self'; object-src 'none'; frame-ancestors 'self' http://localhost:* http://127.0.0.1:*; form-action 'self'
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), geolocation=(), microphone=()
  X-Permitted-Cross-Domain-Policies: none
